{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=TeamManager;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Jwt": {
    "Issuer": "TeamManager.Api",
    "Audience": "TeamManager.Client",
    "ExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },

  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "FromName": "Team-Manager",
    "UseSsl": true
  },

  "AppUrl": { "BaseUrl": "https://Team-Manager-app.com" },

  "Bootstrap": { "AdminSecret": "CHANGE_ME_IN_PRODUCTION_ENV_VAR" },

  "FileStorage": {
    "Provider": "S3",
    "BucketName": "teammanager-attachments-sherif-20261012-8472",
    "Region": "eu-north-1",
    "ProfileName": "teammanager-dev",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [ ".pdf", ".png", ".jpg", ".jpeg", ".docx", ".xlsx" ]
  },

  "RateLimiting": {
    "Global": {
      "PerIpLimit": 300,
      "PerIpWindowSeconds": 60,
      "PerUserLimit": 120,
      "PerUserWindowSeconds": 60
    },

    "Authentication": {
      "Login": {
        "PermitLimit": 5,
        "WindowSeconds": 60
      },

      "Register": {
        "PermitLimit": 5,
        "WindowSeconds": 3600
      },

      "Refresh": {
        "PermitLimit": 30,
        "WindowSeconds": 60
      },

      "ForgotPassword": {
        "PermitLimit": 3,
        "WindowSeconds": 900
      },

      "ResetPassword": {
        "PermitLimit": 5,
        "WindowSeconds": 900
      }
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "https://team-manager-app.com",
      "http://localhost:5173"
    ]
  },
  "AllowedHosts": "*"
}